#!/bin/bash
set -euo pipefail

CONFIG_FILE="/etc/openscan3-dev/config.env"
DROPIN_DIR="/etc/systemd/system/openscan3.service.d"
DROPIN_FILE="${DROPIN_DIR}/20-dev-override.conf"

OPENSCAN_DEV_REPO="https://github.com/OpenScan-org/OpenScan3.git"
OPENSCAN_DEV_BRANCH="develop"
OPENSCAN_DEV_ROOT="/opt/openscan3-dev"
OPENSCAN_DEV_PIWHEELS_INDEX_URL="https://www.piwheels.org/simple"

if [ -f "${CONFIG_FILE}" ]; then
  # shellcheck disable=SC1090
  . "${CONFIG_FILE}"
fi

SRC_DIR="${OPENSCAN_DEV_ROOT}/src"
VENV_DIR="${OPENSCAN_DEV_ROOT}/venv"

usage() {
  cat <<'EOF'
Usage:
  openscan-dev status
  openscan-dev config [--repo URL] [--branch NAME]
  openscan-dev deploy [--repo URL] [--branch NAME] [--no-restart]
  openscan-dev enable [--no-restart]
  openscan-dev disable [--no-restart]

Develop-image helper for testing OpenScan3 firmware from a Git checkout.
EOF
}

need_root() {
  if [ "$(id -u)" -ne 0 ]; then
    echo "openscan-dev must be run as root. Use sudo." >&2
    exit 1
  fi
}

write_config() {
  install -d -m 755 "$(dirname "${CONFIG_FILE}")"
  {
    printf 'OPENSCAN_DEV_REPO=%q\n' "${OPENSCAN_DEV_REPO}"
    printf 'OPENSCAN_DEV_BRANCH=%q\n' "${OPENSCAN_DEV_BRANCH}"
    printf 'OPENSCAN_DEV_ROOT=%q\n' "${OPENSCAN_DEV_ROOT}"
    printf 'OPENSCAN_DEV_PIWHEELS_INDEX_URL=%q\n' "${OPENSCAN_DEV_PIWHEELS_INDEX_URL}"
  } >"${CONFIG_FILE}"
  chmod 0644 "${CONFIG_FILE}"
}

require_value() {
  if [ "$#" -lt 2 ] || [ -z "$2" ]; then
    echo "Missing value for $1" >&2
    exit 1
  fi
}

parse_repo_branch_flags() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --repo)
        require_value "$1" "${2-}"
        OPENSCAN_DEV_REPO="$2"
        shift 2
        ;;
      --branch)
        require_value "$1" "${2-}"
        OPENSCAN_DEV_BRANCH="$2"
        shift 2
        ;;
      *)
        echo "Unknown option: $1" >&2
        usage >&2
        exit 1
        ;;
    esac
  done
}

parse_deploy_flags() {
  RESTART_SERVICE=1
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --repo)
        require_value "$1" "${2-}"
        OPENSCAN_DEV_REPO="$2"
        shift 2
        ;;
      --branch)
        require_value "$1" "${2-}"
        OPENSCAN_DEV_BRANCH="$2"
        shift 2
        ;;
      --no-restart)
        RESTART_SERVICE=0
        shift
        ;;
      *)
        echo "Unknown option: $1" >&2
        usage >&2
        exit 1
        ;;
    esac
  done
}

parse_restart_flag() {
  RESTART_SERVICE=1
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --no-restart)
        RESTART_SERVICE=0
        shift
        ;;
      *)
        echo "Unknown option: $1" >&2
        usage >&2
        exit 1
        ;;
    esac
  done
}

restart_or_reload() {
  systemctl daemon-reload
  if [ "${RESTART_SERVICE}" -eq 1 ]; then
    systemctl restart openscan3
  fi
}

ensure_runtime_dirs() {
  install -d -m 2775 -o openscan -g openscan "${OPENSCAN_DEV_ROOT}"
  install -d -m 2775 -o openscan -g openscan /etc/openscan3
  install -d -m 2775 -o openscan -g openscan /var/openscan3
  install -d -m 2775 -o openscan -g openscan /var/openscan3/projects
  install -d -m 2775 -o openscan -g openscan /var/openscan3/community-tasks
  install -d -m 2775 -o openscan -g openscan /var/log/openscan3
}

checkout_repo() {
  install -d -m 2775 -o openscan -g openscan "${OPENSCAN_DEV_ROOT}"

  if [ ! -d "${SRC_DIR}/.git" ]; then
    rm -rf "${SRC_DIR}"
    runuser -u openscan -- git clone "${OPENSCAN_DEV_REPO}" "${SRC_DIR}"
  fi

  runuser -u openscan -- git -C "${SRC_DIR}" remote set-url origin "${OPENSCAN_DEV_REPO}"
  runuser -u openscan -- git -C "${SRC_DIR}" fetch origin "${OPENSCAN_DEV_BRANCH}"
  runuser -u openscan -- git -C "${SRC_DIR}" checkout -B "${OPENSCAN_DEV_BRANCH}" FETCH_HEAD
  runuser -u openscan -- git -C "${SRC_DIR}" reset --hard FETCH_HEAD
}

install_default_settings_if_empty() {
  if [ -d "${SRC_DIR}/settings" ] && ! find /etc/openscan3 -mindepth 1 -print -quit | grep -q .; then
    cp -a "${SRC_DIR}/settings/." /etc/openscan3/
    chown -R openscan:openscan /etc/openscan3
  fi
}

build_venv() {
  local gphoto2_version

  gphoto2_version="$(sed -n 's/^[[:space:]]*"gphoto2==\([^"]*\)".*$/\1/p' "${SRC_DIR}/pyproject.toml" | head -n 1)"

  rm -rf "${VENV_DIR}"
  runuser -u openscan -- python3 -m venv --system-site-packages "${VENV_DIR}"
  runuser -u openscan -- "${VENV_DIR}/bin/python" -m pip install --upgrade pip

  if [ -n "${gphoto2_version}" ]; then
    runuser -u openscan -- "${VENV_DIR}/bin/python" -m pip install \
      --extra-index-url "${OPENSCAN_DEV_PIWHEELS_INDEX_URL}" \
      --only-binary=:all: \
      "gphoto2==${gphoto2_version}"
  fi

  runuser -u openscan -- bash -lc "cd '${SRC_DIR}' && '${VENV_DIR}/bin/python' -m pip install -e ."
}

write_dropin() {
  install -d -m 755 "${DROPIN_DIR}"
  cat >"${DROPIN_FILE}" <<EOF
[Service]
WorkingDirectory=${SRC_DIR}
ExecStart=
ExecStart=${VENV_DIR}/bin/openscan-firmware serve --root-path /api
Environment=OPENSCAN_SETTINGS_DIR=/etc/openscan3
Environment=OPENSCAN_RUNTIME_DIR=/var/openscan3
Environment=OPENSCAN_PROJECT_DIR=/var/openscan3/projects
Environment=OPENSCAN_COMMUNITY_TASKS_DIR=/var/openscan3/community-tasks
Environment=OPENSCAN_LOG_DIR=/var/log/openscan3
Environment=OPENSCAN_TASK_AUTODISCOVERY=1
Environment=OPENSCAN_TASK_OVERRIDE_ON_CONFLICT=1
EOF
}

status() {
  echo "repo=${OPENSCAN_DEV_REPO}"
  echo "branch=${OPENSCAN_DEV_BRANCH}"
  echo "root=${OPENSCAN_DEV_ROOT}"
  if [ -f "${DROPIN_FILE}" ]; then
    echo "override=enabled"
  else
    echo "override=disabled"
  fi
  if [ -d "${SRC_DIR}/.git" ]; then
    echo "checkout=$(git -C "${SRC_DIR}" rev-parse --short HEAD 2>/dev/null || true)"
    echo "checkout_branch=$(git -C "${SRC_DIR}" branch --show-current 2>/dev/null || true)"
  else
    echo "checkout=missing"
  fi
}

cmd="${1:-}"
if [ -z "${cmd}" ]; then
  usage >&2
  exit 1
fi
shift || true

case "${cmd}" in
  status)
    status
    ;;
  config)
    need_root
    parse_repo_branch_flags "$@"
    write_config
    status
    ;;
  deploy)
    need_root
    parse_deploy_flags "$@"
    write_config
    ensure_runtime_dirs
    checkout_repo
    install_default_settings_if_empty
    build_venv
    write_dropin
    restart_or_reload
    status
    ;;
  enable)
    need_root
    parse_restart_flag "$@"
    if [ ! -x "${VENV_DIR}/bin/openscan-firmware" ] || [ ! -d "${SRC_DIR}/.git" ]; then
      echo "No prepared dev checkout found. Run openscan-dev deploy first." >&2
      exit 1
    fi
    write_dropin
    restart_or_reload
    status
    ;;
  disable)
    need_root
    parse_restart_flag "$@"
    rm -f "${DROPIN_FILE}"
    restart_or_reload
    status
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "Unknown command: ${cmd}" >&2
    usage >&2
    exit 1
    ;;
esac
